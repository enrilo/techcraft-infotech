# Copy this file to .env.local and fill in your real Google Analytics 4 Measurement ID
# Find it in GA4: Admin > Data Streams > (your stream) > Measurement ID (starts with "G-")
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Base URL of the deployed site, used for canonical links, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.enrilotechnologies.com
